# Important: Values for PORT, REACT_APP_BACKEND_PORT, and NODE_ENV must be identical to the values from the frontend .env file!
DATABASE_URL="file:/data/app.db"
APP_PASSWORD="CHANGE_ME"
SESSION_SECRET="CHANGE_ME_TO_A_LONG_RANDOM_VALUE"
PORT="3000"
FRONTEND_URL="https://example.org"
REACT_APP_BACKEND_PORT="3011"
NODE_ENV="production"
SESSION_TIMEOUT_MS="86400000"
SESSION_WARNING_MS="300000"