# Important: The port in FRONTEND_URL must match the value of PORT, and REACT_APP_BACKEND_PORT must be identical to REACT_APP_BACKEND_PORT in the `frontend/.env` file!  
DATABASE_URL="file:/data/app.db"
APP_PASSWORD="CHANGE_ME"
SESSION_SECRET="CHANGE_ME_TO_A_LONG_RANDOM_VALUE"
FRONTEND_URL="https://example.org"
REACT_APP_BACKEND_PORT="3011"
NODE_ENV="production"
SESSION_TIMEOUT_MS="86400000"
SESSION_WARNING_MS="300000"